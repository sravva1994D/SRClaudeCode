# Editor settings shared by all contributors (CLAUDE.md section 5.2)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{ts,html,scss,json,yaml,yml,md}]
indent_style = space
indent_size = 2

[*.ts]
max_line_length = 100
